# ── Backend ─────────────────────────────────────────────────
# Local dev: point this at a locally installed PostgreSQL, or a separate
# Supabase project used just for development:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr04
#
# Supabase (production / Vercel): use the pooled connection (port 6543,
# pgbouncer) for DATABASE_URL, and the direct connection (port 5432) for
# DIRECT_URL — Prisma Migrate needs the direct one since pgbouncer's
# transaction pooling mode doesn't support the prepared statements/advisory
# locks migrations require. Both strings are in Supabase's dashboard under
# Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr04
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Allowed origin for local dev CORS
CORS_ORIGIN=http://localhost:5173

PORT=4000

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
